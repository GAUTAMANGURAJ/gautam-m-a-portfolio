# Free access key from https://web3forms.com (delivers contact form to your Gmail).
# 1) Local: copy this file to .env.local and paste your key.
# 2) GitHub Pages: Repo → Settings → Secrets and variables → Actions
#    → New repository secret named exactly:
#      NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY
#    Without this secret, production falls back to opening the visitor's mail app.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# --- Visitor analytics (privacy-light, no cookies) ---
# Recommended free option: GoatCounter (https://www.goatcounter.com)
# 1) Sign up → create a site → your code is the subdomain (e.g. "gautam-ma" → gautam-ma.goatcounter.com)
# 2) Local: set below in .env.local
# 3) Production: add GitHub Actions secret NEXT_PUBLIC_GOATCOUNTER_CODE
NEXT_PUBLIC_GOATCOUNTER_CODE=

# Optional paid alternative: Plausible (https://plausible.io)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=gautamanguraj.github.io
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# --- Optional: scheduling link ---
# Paste a Cal.com / Calendly URL to show a "Book a 20-min call" channel in the contact section.
# Leave empty to hide it. (GitHub Actions secret name: NEXT_PUBLIC_BOOKING_URL)
NEXT_PUBLIC_BOOKING_URL=
